---
// Component kit: every UI piece on one page, for checking a theme or a new
// component. Only built in `npm run dev` (open /kit or /kit/en); production
// builds skip it.
import type { GetStaticPaths } from 'astro'
import { ArrowUpRight, Copy, Mail, MonitorSmartphone, Send } from '@lucide/astro'
import { Container, NavDrawer, ProjectCard, SectionHeader, Stack } from '@/components'
import {
  AccentPicker,
  ActionsContainer,
  ActionsPanel,
  Card,
  Toolbar,
  ToolbarDot,
  ToolbarGroup,
  ToolbarIconButton,
  ToolbarSelect,
} from '@/components/home'
import { Badge, BrandIcon, Button, Link, Toast } from '@/components/ui'
import { accents, content, defaultLocale, locales, site } from '@/config'
import { projects, type Locale } from '@/data'
import { BaseLayout } from '@/layouts'

export const getStaticPaths = (() =>
  import.meta.env.DEV
    ? locales.map(locale => ({ params: { locale: locale === defaultLocale ? undefined : locale }, props: { locale } }))
    : []) satisfies GetStaticPaths

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = content[locale]
const { home } = copy
const github = site.social[0]
---

<BaseLayout title="Component kit" description="All template components." locale={locale} path="kit">
  <Container tag="main" class="py-16">
    <Stack gap="xl">
      <SectionHeader eyebrow="Kit" title="Components" subtitle="Every UI piece with the active palette and font." />

      <Stack gap="sm">
        <h3 class="text-sm uppercase text-muted">Link</h3>
        <div class="flex flex-wrap items-center gap-8">
          <Link variant="primary" href="#" label={copy.hero.cta} />
          <Link variant="primary" href="#" label={copy.contact.cta} icon={Send} iconPosition="left" />
          <Link variant="secondary" href="#" label={copy.nav[0]?.label ?? 'Nav'} active />
          <Link variant="secondary" href="#" label={copy.nav[1]?.label ?? 'Nav'} />
          {site.social.map(s => <Link variant="tertiary" href={s.href} label={s.label} />)}
          <Link variant="tertiary" href="#" label="Status" active />
        </div>
      </Stack>

      <Stack gap="sm">
        <h3 class="text-sm uppercase text-muted">Button</h3>
        <div class="flex flex-wrap items-center gap-6">
          <Button>{copy.ui.downloadCv}</Button>
          <Button variant="ghost" size="lg">{copy.ui.viewWork}</Button>
          <Button variant="secondary" icon={Mail}>{site.email}</Button>
          <Button size="sm" disabled>Disabled</Button>
          <Button variant="ghost" data-nav-drawer-open aria-expanded="false">{copy.ui.openMenu}</Button>
        </div>
      </Stack>

      <Stack gap="sm">
        <h3 class="text-sm uppercase text-muted">Badge</h3>
        <div class="flex flex-wrap gap-2">
          {copy.about.skills.map(skill => <Badge label={skill} />)}
          <Badge label={copy.proof.availability} color="accent" />
        </div>
      </Stack>

      <Stack gap="sm">
        <h3 class="text-sm uppercase text-muted">ProjectCard</h3>
        <div class="grid gap-10 mobile:grid-cols-2 narrow:grid-cols-3">
          {projects.map(project => <ProjectCard project={project} locale={locale} linkLabel={copy.ui.viewProject} />)}
        </div>
      </Stack>

      <Stack gap="sm">
        <h3 class="text-sm uppercase text-muted">Home: Card</h3>
        <div class="flex max-w-xl flex-col gap-2.5">
          <Card title={home.cta.title} subtitle={home.cta.subtitle} badge={home.cta.badge}>
            <Mail slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
          </Card>
          <Card title={site.email} subtitle={home.cta.subtitle} as="button">
            <Mail slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
            <Copy slot="aside" size={14} stroke-width={1} nonScalingStroke />
          </Card>
          {
            github && (
              <Card title={github.handle} subtitle={home.socialCta} href={github.href}>
                <BrandIcon slot="icon" name={github.icon} size={18} />
                <ArrowUpRight slot="aside" size={14} stroke-width={1} nonScalingStroke />
              </Card>
            )
          }
        </div>
      </Stack>

      <Stack gap="sm">
        <h3 class="text-sm uppercase text-muted">Home: Toolbar, ActionsContainer, AccentPicker</h3>
        <p class="text-sm text-muted">Each item opens its panel below; tap it again, outside, or press Escape to close.</p>
        <div class="mx-auto flex w-full max-w-94 flex-col gap-4">
          <Toolbar>
            <ToolbarGroup grow>
              <ToolbarSelect label={home.presentation.label} controls="kit-select" />
            </ToolbarGroup>
            <ToolbarGroup>
              <ToolbarIconButton label={copy.ui.email} controls="kit-icon">
                <Mail size={14} stroke-width={1} nonScalingStroke />
              </ToolbarIconButton>
            </ToolbarGroup>
            <ToolbarGroup>
              <ToolbarDot label={home.accentLabel} controls="kit-accent" />
            </ToolbarGroup>
          </Toolbar>
          <ActionsContainer>
            <ActionsPanel default>
              <Card title="Default panel" subtitle="Shown while nothing is open">
                <Mail slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
              </Card>
            </ActionsPanel>
            <ActionsPanel id="kit-select" wide>
              {
                home.presentation.options.map(option => (
                  <Card title={option.title} subtitle={option.subtitle} badge={option.badge}>
                    <MonitorSmartphone slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
                  </Card>
                ))
              }
            </ActionsPanel>
            <ActionsPanel id="kit-icon">
              <Card title={site.email} subtitle={home.cta.subtitle}>
                <Mail slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
              </Card>
            </ActionsPanel>
            <ActionsPanel id="kit-accent">
              <AccentPicker colors={accents} label={home.accentLabel} />
            </ActionsPanel>
          </ActionsContainer>
        </div>
      </Stack>
    </Stack>
  </Container>
  <NavDrawer items={copy.nav} closeLabel={copy.ui.closeMenu} navLabel={copy.ui.mainNavigation} />
  <Toast />
</BaseLayout>
