---
// The home: one screen, no scroll. Name, role and tagline, a row of actions
// and a contact card at the top; the back portrait stays at the bottom center,
// where the splash loader leaves it. Content is server-rendered and readable
// before JS: hero-initial.css only dims it and Home.anim.ts lifts it.
import { ArrowUpRight, Copy, FileText, Mail, MonitorSmartphone } from '@lucide/astro'
import { BackPortrait } from '@/components/composed'
import {
  AccentPicker,
  ActionsContainer,
  ActionsPanel,
  Card,
  Toolbar,
  ToolbarDot,
  ToolbarGroup,
  ToolbarIconButton,
  ToolbarSelect,
} from '@/components/home'
import { BrandIcon } from '@/components/ui'
import { activePalette, site } from '@/config'
import type { Content, IntroMode, Locale } from '@/data'

interface Props {
  copy: Content
  locale: Locale
  intro: IntroMode
}

const { copy, intro } = Astro.props
const { home } = copy
const [user, domain] = site.email.split('@')
// Accent colors the dot offers; the first is the theme's default.
const accents = [activePalette.accent, '#295FD7', '#A621D9', '#EE9837', '#EC622E', '#E83657', '#85BC7F']
// One icon per presentation option, in order (Consultor, Contractor).
const optionIcons = [MonitorSmartphone, FileText]
---

<section id="home" class="relative flex h-dvh flex-col overflow-hidden px-4" data-intro-mode={intro}>
  <BackPortrait class="z-0" />

  <div class="relative z-10 mx-auto flex w-full max-w-94 flex-col pt-9">
    <div data-animate="home-item">
      <h1 class="text-lg leading-tight font-semibold">{site.name}</h1>
      <p class="mt-1 text-sm text-accent">{home.role}</p>
    </div>

    <p class="mt-4 text-base leading-snug text-muted" data-animate="home-item">
      {home.tagline.map(line => <span class="block">{line}</span>)}
    </p>

    <Toolbar class="mt-8" data-animate="home-item">
      <ToolbarGroup grow>
        <ToolbarSelect label={home.presentation.label} controls="home-presentation" />
      </ToolbarGroup>
      <ToolbarGroup>
        <ToolbarIconButton label={copy.ui.email} controls="home-email">
          <Mail size={14} stroke-width={1} nonScalingStroke />
        </ToolbarIconButton>
      </ToolbarGroup>
      <ToolbarGroup label={home.socialLabel}>
        {
          site.social.map(link => (
            <ToolbarIconButton label={link.label} controls={`home-social-${link.icon}`}>
              <BrandIcon name={link.icon} size={14} />
            </ToolbarIconButton>
          ))
        }
      </ToolbarGroup>
      <ToolbarGroup>
        <ToolbarDot label={home.accentLabel} controls="home-accent" />
      </ToolbarGroup>
    </Toolbar>

    <ActionsContainer class="mt-4" data-animate="home-item">
      <ActionsPanel default>
        <Card
          title={home.cta.title}
          subtitle={home.cta.subtitle}
          badge={home.cta.badge}
          as="button"
          data-email-button
          data-u={user}
          data-d={domain}
          data-copy-label={copy.ui.copyEmail}
          data-copied={copy.ui.emailCopied}
        >
          <Mail slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
        </Card>
      </ActionsPanel>
      <ActionsPanel id="home-email">
        <Card
          subtitle={home.cta.subtitle}
          as="button"
          data-email-button
          data-show-address
          data-u={user}
          data-d={domain}
          data-copy-label={copy.ui.copyEmail}
          data-copied={copy.ui.emailCopied}
        >
          <Mail slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
          <span slot="title" data-email-label>{copy.ui.email}</span>
          <Copy slot="aside" size={14} stroke-width={1} nonScalingStroke />
        </Card>
      </ActionsPanel>
      {
        site.social.map(link => (
          <ActionsPanel id={`home-social-${link.icon}`}>
            <Card title={link.handle} subtitle={home.socialCta} href={link.href} target="_blank" rel="noopener noreferrer">
              <BrandIcon slot="icon" name={link.icon} size={18} />
              <ArrowUpRight slot="aside" size={14} stroke-width={1} nonScalingStroke />
            </Card>
          </ActionsPanel>
        ))
      }
      <ActionsPanel id="home-accent">
        <AccentPicker colors={accents} label={home.accentLabel} />
      </ActionsPanel>
      <ActionsPanel id="home-presentation" wide>
        {
          home.presentation.options.map((option, i) => {
            const Icon = optionIcons[i] ?? FileText
            return (
              <Card title={option.title} subtitle={option.subtitle} badge={option.badge}>
                <Icon slot="icon" size={18} stroke-width={1.28571} nonScalingStroke />
              </Card>
            )
          })
        }
      </ActionsPanel>
    </ActionsContainer>
  </div>

  <footer class="relative z-10 mt-auto pb-10 text-center text-xs text-muted" data-animate="home-item">
    © {site.name}. {home.footer}
  </footer>
</section>

<script>
  import { bindEmailButtons } from '@/lib/email'
  import { initGsap } from '@/lib/gsap'
  import { INTRO_SEEN_KEY, shouldPlayEntrance } from '@/lib/intro'
  import { prefersReducedMotion } from '@/lib/motion'
  import { whenSplashDone } from '@/lib/splash'
  import type { IntroMode } from '@/data'
  import { createHomeEntrance, setHomeFinal } from './Home.anim'

  bindEmailButtons()

  const home = document.getElementById('home')

  function readSeen(): boolean {
    try {
      return sessionStorage.getItem(INTRO_SEEN_KEY) === '1'
    } catch {
      return false
    }
  }

  function markSeen(): void {
    try {
      sessionStorage.setItem(INTRO_SEEN_KEY, '1')
    } catch {
      // Storage blocked (private mode): the entrance just plays again.
    }
  }

  if (home && !prefersReducedMotion()) {
    const gsap = initGsap()
    const mode = (home.dataset.introMode ?? 'subtle') as IntroMode

    if (shouldPlayEntrance(mode, readSeen(), false)) {
      markSeen()
      void whenSplashDone().then(() => createHomeEntrance(gsap))
    } else {
      setHomeFinal(gsap)
    }
  }
</script>
