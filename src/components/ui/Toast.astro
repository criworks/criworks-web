---
// Fixed pill announced to screen readers, with a check icon before the
// message. Hidden until shown; the show/hide animation lives in
// lib/animations (Phase 5). One per page.
import { Check } from '@lucide/astro'
---

<div
  id="toast"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed inset-x-0 bottom-8 z-50 mx-auto w-fit opacity-0"
>
  <div class="flex items-center gap-2 whitespace-nowrap rounded-full bg-foreground px-4 py-2.5 text-sm font-semibold text-background">
    <Check size={16} stroke-width={2.5} aria-hidden="true" />
    <span id="toast-message"></span>
  </div>
</div>
