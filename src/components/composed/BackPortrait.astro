---
// The back portrait, centered and anchored to the bottom of the viewport.
// Shared by the splash loader and the home so both place it exactly alike:
// when the splash fades out, the image under it is already in the same spot.
// The image is marked data-portrait, with this photo as data-fallback, so the
// home's accent picker can swap in a version per color (components/home/accent.ts).
import { getImage } from 'astro:assets'
import portrait from '@/assets/images/splash-portrait.png'

interface Props {
  id?: string
  class?: string
}

const { id, class: className } = Astro.props
const image = await getImage({ src: portrait, format: 'webp' })
---

<div id={id} class:list={['pointer-events-none absolute right-0 -bottom-[12%] left-0 flex justify-center', className]} aria-hidden="true">
  <img
    src={image.src}
    {...image.attributes}
    alt=""
    loading="eager"
    data-portrait
    data-fallback={image.src}
    class="block h-[73dvh] w-auto max-w-none object-cover"
  />
</div>
