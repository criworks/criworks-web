---
// Toolbar select: a label and the chevrons-left-right icon. Idle it is
// transparent over its group; hover and open give it its own background.
// Opening it shows the ActionsPanel named by `controls` and hides the other
// panels of that ActionsContainer; closing it brings back the default panel.
// The icon follows the wide ActionsPanel's layout: chevrons-left-right while
// its cards sit side by side (the cards breakpoint), chevrons-up-down once
// they stack. In a compact toolbar only the icon shows, at the width of an
// icon button.
import { ChevronsLeftRight, ChevronsUpDown } from '@lucide/astro'

interface Props {
  label: string
  /** id of the ActionsPanel with the options. */
  controls: string
}

const { label, controls } = Astro.props
---

<button
  type="button"
  data-toolbar-toggle
  aria-expanded="false"
  aria-controls={controls}
  class="flex w-full cursor-pointer items-center gap-0.5 rounded-full px-2 py-1.5 text-xs leading-[18px] tracking-[-0.078px] text-foreground transition-colors hover:bg-glass-raised aria-expanded:bg-glass-raised"
>
  <span class="min-w-0 flex-1 truncate text-left @max-toolbar-compact:sr-only">{label}</span>
  <span class="flex size-4.5 shrink-0 items-center justify-center" aria-hidden="true">
    <ChevronsUpDown size={14} stroke-width={1} nonScalingStroke class="cards:hidden" />
    <ChevronsLeftRight size={14} stroke-width={1} nonScalingStroke class="hidden cards:block" />
  </span>
</button>

<script>
  import { bindToolbarToggles } from './toolbar'
  bindToolbarToggles()
</script>
