---
// Glass pill that holds toolbar items with no gap between them. `grow` lets
// it take the free width of the row (the select uses it) until the toolbar
// is compact, where the select drops its label and the group shrinks to fit. `label` names the
// group for screen readers.
interface Props {
  grow?: boolean
  label?: string
  class?: string
}

const { grow = false, label, class: className } = Astro.props
---

<div
  class:list={['flex shrink-0 items-start rounded-full bg-glass p-1 backdrop-blur-glass', grow && 'min-w-0 flex-1 @max-toolbar-compact:flex-none', className]}
  role={label ? 'group' : undefined}
  aria-label={label}
>
  <slot />
</div>
