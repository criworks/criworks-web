---
// Status dot in the accent color (availability). `label` is its accessible
// name and tooltip.
interface Props {
  label: string
}

const { label } = Astro.props
---

<span class="flex h-7.5 w-8.5 items-center justify-center px-2 py-1.5" role="img" aria-label={label} title={label}>
  <span class="size-[17px] shrink-0 rounded-full bg-accent"></span>
</span>
