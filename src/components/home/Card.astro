---
// Notification-style card, like an iOS push notification (visual only): a
// black icon tile, the title with an optional badge at the right, and a muted
// subtitle. With `href` it is a link; other attributes (data-*) pass through,
// so a card can also be a mailto hook. The icon goes in the `icon` slot.
interface Props {
  title: string
  subtitle: string
  badge?: string
  href?: string
  class?: string
  [attr: `data-${string}`]: string | undefined
}

const { title, subtitle, badge, href, class: className, ...attrs } = Astro.props
const Tag = href || 'data-mailto' in attrs ? 'a' : 'div'
---

<Tag
  href={href}
  class:list={[
    'flex min-w-0 flex-1 items-start gap-3 rounded-2xl bg-white/8 p-3 backdrop-blur-[40px]',
    Tag === 'a' && 'transition-colors hover:bg-white/12',
    className,
  ]}
  {...attrs}
>
  <span class="flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-[10px] bg-black" aria-hidden="true">
    <slot name="icon" />
  </span>
  <span class="flex min-h-10 min-w-0 flex-1 flex-col justify-center gap-0.5">
    <span class="flex items-start gap-2.5">
      <span class="min-w-0 flex-1 truncate text-sm leading-[18px] font-medium tracking-[-0.5px] text-white">{title}</span>
      {badge && <span class="shrink-0 text-right text-xs leading-[18px] tracking-[-0.078px] text-muted">{badge}</span>}
    </span>
    <span class="truncate text-sm leading-[18px] tracking-[-0.078px] text-muted">{subtitle}</span>
  </span>
</Tag>
