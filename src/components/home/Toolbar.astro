---
// A row of toolbar groups (ToolbarGroup), 10px apart. It is the container
// the items query to go compact (--container-toolbar-compact).
interface Props {
  class?: string
  'data-animate'?: string
}

const { class: className, ...attrs } = Astro.props
---

<div class:list={['@container flex w-full items-start justify-center gap-2.5', className]} {...attrs}>
  <slot />
</div>
