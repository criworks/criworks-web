---
// Icon-only toolbar item, same hover as the select. A link with `href`,
// a button otherwise; `label` is its accessible name. Other attributes
// (target, rel, data-*) pass through. The icon goes in the default slot.
interface Props {
  label: string
  href?: string
  target?: string
  rel?: string
  [attr: `data-${string}`]: string | undefined
}

const { label, href, ...attrs } = Astro.props
const Tag = href ? 'a' : 'button'
---

<Tag
  href={href}
  type={href ? undefined : 'button'}
  aria-label={label}
  class="flex cursor-pointer items-center rounded-full px-2 py-1.5 text-white transition-colors hover:bg-white/10"
  {...attrs}
>
  <span class="flex size-4.5 items-center justify-center" aria-hidden="true">
    <slot />
  </span>
</Tag>
