---
// One view of an ActionsContainer: its items centered, 10px apart. The
// `default` panel shows first; the others stay hidden until a ToolbarSelect
// opens them (give them the id it `controls`). With `scroll` each item keeps
// the 281px of the design and the row scrolls sideways when they don't fit.
interface Props {
  id?: string
  default?: boolean
  scroll?: boolean
}

const { id, default: isDefault = false, scroll = false } = Astro.props
---

<div
  id={id}
  data-actions-panel={isDefault ? 'default' : ''}
  hidden={!isDefault}
  class:list={[
    'w-full items-start justify-center-safe gap-2.5 [&:not([hidden])]:flex',
    scroll && 'snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] *:w-70.25 *:flex-none *:snap-start',
  ]}
>
  <slot />
</div>
