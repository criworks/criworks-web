---
// One view of an ActionsContainer: its items centered, 10px apart. The
// `default` panel shows first; the others stay hidden until a ToolbarSelect
// opens them (give them the id it `controls`). With `wide` the items keep
// the 281px of the design side by side, centered on the ActionsContainer and
// spreading past it on both sides; when the viewport can't fit two of them
// (the cards breakpoint) they stack at the container's width.
interface Props {
  id?: string
  default?: boolean
  wide?: boolean
}

const { id, default: isDefault = false, wide = false } = Astro.props
---

<div
  id={id}
  data-actions-panel={isDefault ? 'default' : ''}
  hidden={!isDefault}
  class:list={[
    'w-full items-start justify-center gap-2.5 [&:not([hidden])]:flex',
    wide &&
      'flex-col *:w-full cards:relative cards:left-1/2 cards:w-max cards:flex-none cards:-translate-x-1/2 cards:flex-row cards:*:w-70.25 cards:*:flex-none',
  ]}
>
  <slot />
</div>
